---
// Standalone page for Meissen. Everything shown at /work/meissen lives in this
// file: markup, sizes and styles. Editing it affects no other page.
import "../../styles/vars.css";
import "../../styles/content.css";
import "../../styles/layout.css";

const title = "Meissen";
const viewerSrc =
  "https://splat-viewer-dts.al-soro73.workers.dev/v/g_amor_comprimidowhitebalance?key=0a6efd78-9f94-452b-a97c-c521783b5339";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem("theme") === "dark") {
        document.documentElement.setAttribute("data-theme", "dark");
      }
    </script>
  </head>

  <body class="site-wrapper">
    <header class="page-head">
      <span class="page-title">{title}</span>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
        <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
        <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </header>

    <main class="page-main">
      <section class="viewer-section">
        <iframe
          src={viewerSrc}
          title="Meissen 3D viewer"
          allow="accelerometer; gyroscope; fullscreen"
          allowfullscreen
        ></iframe>
      </section>
    </main>

    <style>
      .page-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin: 0 1rem;
      }

      .page-title {
        font-family: var(--font-sans-serif);
        color: var(--color-base);
        font-size: 3rem;
        font-weight: 500;
      }

      .theme-toggle {
        background: none;
        border: none;
        cursor: pointer;
        color: var(--color-base);
        padding: 10px;
      }

      .page-main {
        padding-top: 3rem;
        padding-bottom: 3rem;
      }

      /* Size of the viewer block: edit these freely. */
      .viewer-section {
        max-width: 1200px;
        margin: 0 auto;
      }

      .viewer-section iframe {
        display: block;
        width: 100%;
        height: 70vh;
        min-height: 400px;
        border: none;
      }

      @media (max-width: 850px) {
        .viewer-section iframe {
          height: 55vh;
        }
      }
    </style>

    <script is:inline>
      const toggle = document.getElementById("theme-toggle");
      const paintIcons = () => {
        const isDark =
          document.documentElement.getAttribute("data-theme") === "dark";
        document.querySelector(".sun-icon").style.display = isDark
          ? "inline-block"
          : "none";
        document.querySelector(".moon-icon").style.display = isDark
          ? "none"
          : "inline-block";
      };
      paintIcons();
      toggle.addEventListener("click", () => {
        const next =
          document.documentElement.getAttribute("data-theme") === "dark"
            ? "light"
            : "dark";
        if (next === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
        localStorage.setItem("theme", next);
        paintIcons();
      });
    </script>
  </body>
</html>
